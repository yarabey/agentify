# deploy/.env.example — шаблон локального окружения для docker compose (0.3).
#
# Скопируйте в deploy/.env и подставьте значения:  cp deploy/.env.example deploy/.env
# Реальный deploy/.env НЕ коммитится (.gitignore). Здесь только плейсхолдеры —
# никаких настоящих секретов в репозитории (AGENTS.md §8).
#
# Имена переменных сервисов соответствуют platform.Config (префиксы ORCH_/BOT_):
# ENV, LOG_LEVEL, LOG_FORMAT, HEALTH_ADDR (HEALTH_ADDR фиксируется в compose).

# --- Postgres -----------------------------------------------------------------
POSTGRES_USER=agentify
# ОБЯЗАТЕЛЬНО задайте непустой пароль (compose упадёт без него):
POSTGRES_PASSWORD=change-me-local-password
POSTGRES_DB=agentify

# --- Оркестратор (префикс ORCH_) ----------------------------------------------
ORCH_ENV=dev
ORCH_LOG_LEVEL=info
ORCH_LOG_FORMAT=json
# ORCH_DATABASE_URL собирается в docker-compose.yml из POSTGRES_* — переопределять
# здесь не нужно.
# Подпись access-JWT (тикет 1.3) и мастер-ключ шифрования at-rest (тикет 2.2):
# ОБЯЗАТЕЛЬНЫ (compose и оркестратор падают без них при поднятой БД). Значения
# ниже — локальные НЕ-секретные дефолты (как POSTGRES_PASSWORD выше), для прода
# сгенерируйте свои (MANUAL_STEPS.md §2 или deploy/setup/macos-01-secrets.sh).
# Имена совпадают с GitHub Secrets из MANUAL_STEPS.md §3; docker-compose.yml
# маппит их в ORCH_JWT_SIGNING_KEY/ORCH_APP_ENCRYPTION_KEY.
JWT_SIGNING_KEY=local-dev-jwt-signing-key-not-a-secret
# Ровно 32 байта после base64-декодирования (openssl rand -base64 32); здесь —
# base64 от фиксированной dev-строки:
APP_ENCRYPTION_KEY=bG9jYWwtZGV2LW9ubHktbm90LWEtc2VjcmV0LWtleSE=

# --- Telegram-бот (префикс BOT_) ----------------------------------------------
BOT_ENV=dev
BOT_LOG_LEVEL=info
BOT_LOG_FORMAT=json
# Webhook (тикет 10.1, FR D1). В dev можно оставить пустыми — бот поднимет только
# /healthz. Секреты НЕ коммитятся (реальный deploy/.env в .gitignore):
#   BOT_TOKEN            — токен @BotFather (в проде = GitHub Secret TELEGRAM_BOT_TOKEN);
#   BOT_WEBHOOK_SECRET   — секрет пути /webhook/<secret> и secret_token (openssl rand -hex 16);
#   BOT_PUBLIC_URL       — внешний адрес за Caddy, напр. https://bot.<домен> (задан → SetWebhook на старте).
BOT_TOKEN=
BOT_WEBHOOK_SECRET=
BOT_PUBLIC_URL=
# BOT_SERVICE_SECRET — сервисный секрет бот↔оркестратор (тикет 10.3, FR D1),
# нужен действиям из Telegram (постановка/отмена задачи, ответ на вопрос,
# POST /channels/telegram/token). ОДНА переменная передаётся ОБОИМ сервисам
# (docker-compose.yml подставляет её и в BOT_SERVICE_SECRET бота, и в
# ORCH_BOT_SERVICE_SECRET оркестратора) — генерируется однократно
# (openssl rand -base64 32), пусто в dev → действия из Telegram отключены.
BOT_SERVICE_SECRET=

# --- Фронтовый Caddy ----------------------------------------------------------
# Внешний HTTP-порт, на котором публикуется стек локально.
HTTP_PORT=8080

# --- Бэкап Postgres (тикет 11.5, опциональный оверрай docker-compose.backup.yml)
# Новых секретов НЕ добавляет: бэкап использует POSTGRES_* выше (тот же пароль).
# Расписание crontab (UTC). По умолчанию — ежедневно в 03:00.
BACKUP_SCHEDULE=0 3 * * *
# Сколько дней хранить файлы дампов (ротация; история в БД бессрочна, FR I2).
BACKUP_RETENTION_DAYS=7
