# deploy/.env.example — шаблон локального окружения для docker compose (0.3).
#
# Скопируйте в deploy/.env и подставьте значения:  cp deploy/.env.example deploy/.env
# Реальный deploy/.env НЕ коммитится (.gitignore). Здесь только плейсхолдеры —
# никаких настоящих секретов в репозитории (AGENTS.md §8).
#
# Имена переменных сервисов соответствуют platform.Config (префиксы ORCH_/BOT_):
# ENV, LOG_LEVEL, LOG_FORMAT, HEALTH_ADDR (HEALTH_ADDR фиксируется в compose).

# --- Postgres -----------------------------------------------------------------
POSTGRES_USER=agentify
# ОБЯЗАТЕЛЬНО задайте непустой пароль (compose упадёт без него):
POSTGRES_PASSWORD=change-me-local-password
POSTGRES_DB=agentify

# --- Оркестратор (префикс ORCH_) ----------------------------------------------
ORCH_ENV=dev
ORCH_LOG_LEVEL=info
ORCH_LOG_FORMAT=json
# ORCH_DATABASE_URL собирается в docker-compose.yml из POSTGRES_* — переопределять
# здесь не нужно.

# --- Telegram-бот (префикс BOT_) ----------------------------------------------
BOT_ENV=dev
BOT_LOG_LEVEL=info
BOT_LOG_FORMAT=json
# Webhook (тикет 10.1, FR D1). В dev можно оставить пустыми — бот поднимет только
# /healthz. Секреты НЕ коммитятся (реальный deploy/.env в .gitignore):
#   BOT_TOKEN            — токен @BotFather (в проде = GitHub Secret TELEGRAM_BOT_TOKEN);
#   BOT_WEBHOOK_SECRET   — секрет пути /webhook/<secret> и secret_token (openssl rand -hex 16);
#   BOT_PUBLIC_URL       — внешний адрес за Caddy, напр. https://bot.<домен> (задан → SetWebhook на старте).
BOT_TOKEN=
BOT_WEBHOOK_SECRET=
BOT_PUBLIC_URL=

# --- Фронтовый Caddy ----------------------------------------------------------
# Внешний HTTP-порт, на котором публикуется стек локально.
HTTP_PORT=8080
