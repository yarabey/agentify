# deploy/Caddyfile.prod — фронтовый reverse proxy для прод-деплоя (тикет 0.5).
#
# Назначение (бизнес): прод-аналог deploy/Caddyfile (тикет 0.3). Та же раскладка
# маршрутов на бэкенды (01_tech_stack §1, §3: единая точка входа инфраструктуры):
#   - app.<домен>  → статика web (+ /healthz фронта);
#   - api.<домен>  → оркестратор (REST+WS ядра, FR E*/A*/F*);
#   - bot.<домен>  → Telegram-бот (webhook, EPIC 10).
# Локально (0.3) это были path-префиксы на одном порту :8080 без TLS; на проде —
# отдельные домены (DNS A-записи app./api./bot.<домен>, см. MANUAL_STEPS.md §1) с
# автоматическим Let's Encrypt TLS. Сами префиксы /api, /bot больше не нужны —
# их роль теперь играет домен: оркестратор/бот видят запросы как обращение к
# своему корню, поэтому handle_path с обрезкой префикса не используется.
#
# Как устроено (тех): домены подставляются из окружения контейнера (Caddy умеет
# {$VAR} в Caddyfile) — значения задаёт человек на VPS через docker-compose.prod.yml
# (APP_DOMAIN/API_DOMAIN/BOT_DOMAIN), без них compose откажется стартовать
# (`${VAR:?...}` в compose-файле). Этот файл подключается вместо
# deploy/Caddyfile bind-mount'ом в docker-compose.prod.yml — образ caddy у обоих
# окружений один и тот же (deploy/caddy.Dockerfile), различается только
# смонтированный конфиг.
#
# Автоматический HTTPS: когда адрес сайт-блока — настоящий домен (не localhost и
# не голый порт), Caddy сам получает и продлевает сертификат Let's Encrypt — явно
# включать ничего не нужно (в отличие от локального Caddyfile, где `auto_https off`
# именно потому, что там голый :8080 без домена). `admin off` оставляем и здесь:
# admin API Caddy в проде наружу не нужен (лишняя поверхность атаки), сам Caddy
# им не пользуется для базового reverse-proxy + авто-TLS.

{
	admin off
}

# --- app.<домен>: статика web + liveness фронта -----------------------------
{$APP_DOMAIN} {
	handle /healthz {
		respond "ok" 200
	}

	handle {
		reverse_proxy web:8080
	}
}

# --- api.<домен>: REST+WS оркестратора --------------------------------------
{$API_DOMAIN} {
	reverse_proxy orchestrator:8080
}

# --- bot.<домен>: Telegram-webhook бота -------------------------------------
{$BOT_DOMAIN} {
	reverse_proxy bot:8080
}
