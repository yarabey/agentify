{
  "name": "@agentify/web",
  "private": true,
  "version": "0.1.0-mvp",
  "license": "FSL-1.1-ALv2",
  "description": "Web PWA оркестратора (тикет 9.1): Vite + React 18 + TS, роутинг (react-router-dom), TanStack Query, генерённый API-клиент (openapi-fetch + openapi-typescript), vite-plugin-pwa (installable shell), Tailwind CSS + shadcn/ui, WS-хук с реконнектом. Экраны — заглушки; реальная реализация в тикетах 9.2-9.6.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "gen:api": "openapi-typescript ../api/openapi.yaml -o src/api/schema.ts",
    "e2e": "playwright test --config=e2e/playwright.config.ts",
    "e2e:typecheck": "tsc --noEmit -p e2e/tsconfig.json"
  },
  "dependencies": {
    "@hookform/resolvers": "5.4.0",
    "@radix-ui/react-label": "2.1.11",
    "@radix-ui/react-slot": "1.3.0",
    "@tanstack/react-query": "5.101.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.22.0",
    "openapi-fetch": "0.17.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.80.0",
    "react-router-dom": "6.30.4",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
