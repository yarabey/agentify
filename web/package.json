    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.0.3",
    "autoprefixer": "10.5.2",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.16",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.9.3",
    "vite": "8.1.2",
