# web/Caddyfile — внутренний статический сервер web-канала (тикет 0.3).
#
# Назначение: раздать статику web (заглушку 0.3 / реальный PWA из 9.1) и отдать
# собственный /healthz, чтобы фронтовый Caddy и smoke-скрипт могли проверить
# живость web-сервиса. Этот Caddy НЕ терминирует TLS и не виден наружу — он
# слушает только внутри compose-сети; внешний доступ идёт через front-Caddy
# (deploy/Caddyfile).

:8080 {
	# liveness web-сервиса (приёмка 0.3 «/healthz всех сервисов отвечает»).
	handle /healthz {
		respond "ok" 200
	}

	# Статика SPA: отдаём файлы из /srv, неизвестные пути заворачиваем на
	# index.html (клиентский роутинг PWA, пригодится с тикета 9.1).
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
